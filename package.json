{
  "name": "ttisland",
  "version": "0.17.0-rc.3",
  "description": "TTIsland desktop companion",
  "main": "main.cjs",
  "author": "TTIsland",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64",
    "test:living": "node tests/living.cjs",
    "test:devices": "node tests/device-control.cjs && node tests/device-ui.cjs",
    "test:liquid": "node tests/liquid-feature.cjs",
    "test:release": "node tests/release-readiness.cjs && node tests/device-control.cjs && node tests/system-controls.cjs && node tests/home-no-settings.cjs && node tests/liquid-feature.cjs",
    "check:windows": "node tests/windows-smoke.cjs",
    "test:compact-track": "node tests/compact-track-themes.cjs",
    "test:window-close": "node tests/window-close.cjs",
    "test:apple": "node tests/apple-music.cjs",
    "test:motion": "node tests/motion-coordination.cjs && node tests/window-motion.cjs && node tests/motion-transition.cjs && node tests/transition-frames.cjs && node tests/service-bottom-frames.cjs && node tests/service-resize-ipc.cjs",
    "test:motion-endpoint": "node tests/motion-endpoint.cjs",
    "test:motion-home": "node tests/motion-home-smooth.cjs",
    "test:motion-handoff": "node tests/anchor-and-service-handoff.cjs && node tests/service-handoff-ui.cjs && node tests/contour-transition-cost.cjs && node tests/rc8-visible-handoff.cjs",
    "test:motion-visible": "node tests/motion-visible-frames.cjs"
  },
  "devDependencies": {
    "electron": "42.0.0",
    "electron-builder": "26.0.12",
    "playwright": "1.56.1"
  },
  "build": {
    "appId": "local.island.lab",
    "productName": "TTIsland",
    "files": [
      "index.html",
      "main.cjs",
      "preload.cjs",
      "music-adapter.js",
      "music-controller.cjs",
      "music-preload.cjs",
      "recording.cjs",
      "assets/**",
      "desktop-tools.cjs",
      "extras.css",
      "extras.js",
      "native/**",
      "plus.js",
      "plus.css",
      "provider-controller.cjs",
      "generic-player.js",
      "voice.cjs",
      "LICENSE",
      "THIRD-PARTY-NOTICES.md",
      "contour.js",
      "window-controls.js",
      "window-shell.cjs",
      "weather-controller.cjs",
      "weather-reader.js",
      "mail-controller.cjs",
      "mail-main.cjs",
      "monitor.cjs",
      "monitor-main.cjs",
      "enhancements.js",
      "enhancements.css",
      "IMAPFLOW-LICENSE.txt",
      "mascots.js",
      "mascots.css",
      "themes.css",
      "themes.js",
      "player.css",
      "wireless.js",
      "wireless.css",
      "dashboard.js",
      "dashboard.css",
      "forecast.js",
      "forecast.css",
      "living.js",
      "living.css",
      "system-controls.cjs",
      "device-control.cjs",
      "device-ui.js",
      "device-ui.css",
      "apple-player.js",
      "motion.js",
      "liquid-fx.js",
      "liquid-fx.css",
      "mascot-speed.js"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/island.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/island.ico",
      "uninstallerIcon": "assets/island.ico",
      "installerHeaderIcon": "assets/island.ico",
      "shortcutName": "TTIsland"
    },
    "asarUnpack": [
      "native/**"
    ],
    "artifactName": "TTIsland-${version}-Setup-${arch}.${ext}",
    "publish": null
  },
  "dependencies": {
    "imapflow": "2.11.0"
  }
}
